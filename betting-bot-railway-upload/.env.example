# Read-only Norsk Tipping Oddsen API configuration.
# Fill these from documented public API paths only.
NT_APP_NAME=betting-analysis-bot
NT_BASE_URL=https://api.norsk-tipping.no/OddsenGameInfo/v1/api
NT_ODDS_ENDPOINT=/events/{sportId}
NT_SPORT_TYPES_ENDPOINT=/sportTypes
NT_MARKETS_ENDPOINT=/markets/{eventId}
NT_DEFAULT_FOOTBALL_SPORT_ID=FBL
NT_TIMEOUT_SECONDS=10
NT_MAX_RETRIES=3
NT_RATE_LIMIT_SLEEP_SECONDS=0.5

# External football statistics provider.
# FootyStats is the primary provider. Use FOOTBALL_STATS_PROVIDER=json for local normalized stats.
FOOTBALL_STATS_PROVIDER=footystats
REQUIRE_EXTERNAL_STATS=true
MARKET_ONLY_DATA_QUALITY=0.72
MARKET_ONLY_CONFIDENCE_CAP=0.63
FOOTYSTATS_API_KEY=
FOOTYSTATS_BASE_URL=https://api.football-data-api.com
FOOTYSTATS_CACHE_DIR=data/cache/footystats
FOOTYSTATS_CACHE_TTL_SECONDS=21600
FOOTYSTATS_SEASON_MAP_JSON=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_RECENT_MATCHES=10
EXTERNAL_STATS_FILE=data/external_stats.json
MIN_TEAM_MAPPING_SCORE=0.82
STATS_TIMEOUT_SECONDS=10
STATS_RATE_LIMIT_SLEEP_SECONDS=0.25

# Analysis filters.
EDGE_THRESHOLD=0.01
EXPECTED_VALUE_THRESHOLD=0.015
MAX_EXPECTED_VALUE=0.10
MIN_ODDS=1.4
MAX_ODDS=4.5
CONFIDENCE_THRESHOLD=0.55
DATA_QUALITY_THRESHOLD=0.65
MAX_RESULTS=20
RECOMMENDATION_HISTORY_FILE=data/recommendations/historical_picks.jsonl
BACKTEST_HISTORY_FILE=data/historical/predictions.csv

# Cloud/API deployment.
BETTING_BOT_WINDOW_HOURS=24
BETTING_BOT_MAX_LEAGUES=50
BETTING_BOT_MAX_RESULTS=30
ALLOWED_ORIGINS=https://bettrack.org,http://localhost:3000
LATEST_PICKS_PATH=data/latest_picks.json

# Bankroll and staking.
BANKROLL=10000
STAKING_STRATEGY=fractional_kelly
KELLY_FRACTION=0.25
FLAT_STAKE_PCT=0.01
MAX_STAKE_PCT=0.01
MIN_STAKE_PCT=0.001
